# Visual Studio 2015 user specific files
.vs/

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Compiled Dynamic libraries
*.so
*.dylib
*.dll

# Fortran module files
*.mod

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app
*.ipa

# These project files can be generated by the engine
*.xcodeproj
*.xcworkspace
*.sln
*.suo
*.opensdf
*.sdf
*.VC.db
*.VC.opendb

# Precompiled Assets
SourceArt/**/*.png
SourceArt/**/*.tga

# Binary Files
Binaries/*
Plugins/**/Binaries/*

# Builds
Build/*

# Whitelist PakBlacklist-<BuildConfiguration>.txt files
!Build/*/
Build/*/**
!Build/*/PakBlacklist*.txt

# Don't ignore icon files in Build
!Build/**/*.ico

# Built data for maps
*_BuiltData.uasset

# Configuration files generated by the Editor
Saved/*

# Compiled source files for the engine to use
Intermediate/*
Plugins/**/Intermediate/*

# Cache files for the editor to use
DerivedDataCache/*



# --- Audio Middleware Build Outputs & Cache ---
# If using Wwise: Ignore local user settings and cache, but KEEP designer files
.wwise-cache/
RootAuthoring/ProjectName_WwiseProject/.ext/
RootAuthoring/ProjectName_WwiseProject/Conversion Settings/.cache/

# If using FMOD: Ignore local cache and user preferences
.fmod_cache/
Plugins/FMODStudio/Binaries/

# --- DAW Backup & Peak Files (Crucial for Audio Editors) ---
# REAPER temporary files
*.rpp-bak
*.reapeaks
*.rpp-back*

# Pro Tools backups and cache
Session File Backups/
Waveform Cache.wfm
AAX Plug-In Settings/

# Ableton / Logic / General temporary audio data
*.asd
*Peak.Format
.DS_Store